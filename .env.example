# ---- Cloudflare (the only required account; everything runs on the free plan) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # prefer a least-privilege token: Workers Scripts, Workers AI, Vectorize, KV, AI Gateway (Edit)
CLOUDFLARE_VECTORIZE_INDEX=agribot-knowledge
CLOUDFLARE_KV_NAMESPACE_ID=      # printed by worker/scripts/setup-cloudflare.sh (used by push_satellite_snapshots.py)

# Shared access code: protects your free AI budget from strangers who find the URL.
# Set it as a Worker secret:  cd worker && npx wrangler secret put ACCESS_CODE
ACCESS_CODE=
AGENT_URL=https://agribot.<your-subdomain>.workers.dev

# ---- Phone number: Vapi (call orchestrator; the only provider with free voice credits + a free number) ----
VAPI_PRIVATE_KEY=
VAPI_WEBHOOK_SECRET=             # random secret; also a Worker secret:  npx wrangler secret put VAPI_WEBHOOK_SECRET
VAPI_ASSISTANT_ID=               # pin when the Vapi account holds other assistants
VAPI_PHONE_NUMBER_ID=
VITE_PHONE_NUMBER=               # shown in the app's call dialog, e.g. +15305550000

# ---- Free LLM fallbacks for when Workers AI is out of neurons (set as Worker secrets too) ----
GROQ_API_KEY=
GROQ_MODEL=                      # default qwen/qwen3.8-27b (check availability: node worker/scripts/check-llm.mjs)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Optional extras (not needed for voice/chat) ----
GEE_SERVICE_ACCOUNT_FILE=        # Earth Engine: map tiles + push_satellite_snapshots.py
GEMINI_API_KEY=                  # Field Vision (Google Gemini/Veo)
VEO_API_KEY=
MORPH_API_KEY=
